# ============================================================
# Environment Variables Configuration for Spotify-like Backend
# ============================================================

# Application
APP_NAME=SpotifyCloneBackend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL with asyncpg for Supabase, or SQLite for local dev)
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# For Local SQLite fallback: sqlite+aiosqlite:///./music_app.db
DATABASE_URL=sqlite+aiosqlite:///./music_app.db

# Supabase Keys (Optional for client SDKs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (For Playback synchronization, Pub/Sub & Caching)
# e.g., redis://localhost:6379/0 or rediss://default:[password]@[host]:[port]
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Firebase Authentication (Service Account Credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC..."
FIREBASE_CREDENTIALS_PATH=

# In local/testing mode, mock token verification can be enabled if no Firebase credentials exist
FIREBASE_EMULATOR_ENABLED=True

# JWT & Security
JWT_AUDIENCE=your-firebase-project-id
CORS_ORIGINS=["*"]

# Recommendation Engine Tuning
MIN_LISTEN_SECONDS=30
MIN_COMPLETION_PERCENTAGE=50
RECOMMENDATION_CACHE_TTL_SECONDS=3600

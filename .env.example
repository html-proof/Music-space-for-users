# ============================================================
# Environment Variables Configuration for Spotify-like Backend
# ============================================================

# Application
APP_NAME=SpotifyCloneBackend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL with asyncpg for Supabase, or SQLite for local dev)
# For Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# For Local SQLite fallback: sqlite+aiosqlite:///./music_app.db
DATABASE_URL=sqlite+aiosqlite:///./music_app.db

# Supabase Keys (Optional for client SDKs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (For Playback synchronization, Pub/Sub & Caching)
# e.g., redis://localhost:6379/0 or rediss://default:[password]@[host]:[port]
# Paste the value unquoted and with no trailing whitespace: the password is sent
# verbatim, so a stray character surfaces as "invalid username-password pair".
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Optional Upstash REST pair, used ONLY when REDIS_URL is left at its default.
# UPSTASH_REDIS_REST_TOKEN authenticates the HTTP REST API and is not
# necessarily the same secret as the RESP password in the rediss:// URL, so
# prefer REDIS_URL from the Upstash console's "Redis" connect tab.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Firebase Authentication (Service Account Credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...................................."
FIREBASE_CREDENTIALS_PATH=

# In local/testing mode, mock token verification can be enabled if no Firebase credentials exist
FIREBASE_EMULATOR_ENABLED=True

# JWT & Security
JWT_AUDIENCE=your-firebase-project-id
CORS_ORIGINS=["*"]

# Recommendation Engine Tuning
MIN_LISTEN_SECONDS=30
MIN_COMPLETION_PERCENTAGE=50
RECOMMENDATION_CACHE_TTL_SECONDS=3600

# Machine Learning (learned ranker for recommendations, search, and autoplay)
# ML_ENABLED=False routes every surface back to the hand-tuned prior heuristics.
ML_ENABLED=True
# Retrain on a background loop inside this process. Prefer leaving this False
# locally and running `python scripts/train_ml.py` by hand instead. In
# production (render.yaml) this is True: Render's free plan has no cron job
# facility to run scripts/train_ml.py on a schedule, so the web process
# retrains itself instead -- it skips passes with too little new data, so it
# is safe to leave on permanently.
ML_AUTO_TRAIN_ENABLED=False
ML_TRAIN_INTERVAL_MINUTES=360
ML_MIN_TRAINING_SAMPLES=200
# Shared secret required by POST /api/ml/retrain and /api/ml/invalidate-cache.
# Leave unset to disable both endpoints (scripts/train_ml.py still works
# without it, since it talks to the database directly).
ML_ADMIN_TOKEN=
ML_EXPLORATION_RATE=0.10
ML_EMBEDDING_DIM=256
ML_CANDIDATE_LIMIT=400

# Shared secret required by PUT/DELETE /api/songs/{id}/lyrics. Leave unset to
# disable writes; reads (GET) stay open to any authenticated user.
LYRICS_ADMIN_TOKEN=

# Periodic in-process check for new songs by followed artists (fans out as
# push notifications). Prefer running scripts/check_new_releases.py as a
# separate cron job instead and leaving this off.
RELEASE_WATCH_ENABLED=False
RELEASE_WATCH_INTERVAL_MINUTES=180

# Catalog write queue. Gaana rows that a search or feed touches are queued and
# written in one batch every CATALOG_FLUSH_INTERVAL_SECONDS instead of inline
# in the request. The same pass trims `albums` to CATALOG_MAX_ALBUMS, least
# recently touched first, skipping anything a user saved, liked, downloaded, or
# put in a playlist or history. Turn the queue off to write through
# synchronously; the album cap goes with it.
CATALOG_WRITE_QUEUE_ENABLED=True
CATALOG_FLUSH_INTERVAL_SECONDS=120
CATALOG_MAX_ALBUMS=20000

# Durable catalog synchronization queue (catalog_sync_jobs). Albums and songs
# that still need fetching from the music API are recorded as jobs in the
# database, so unfinished work survives restarts and is never dropped because a
# newer request arrived. The same 2-minute worker processes them, highest
# priority first (currently playing 100, next queued 90, album tracks 70,
# requested 40, background fill 10). Failures retry with exponential backoff
# and come to rest at FAILED; completed jobs are archived after the retention
# window and only then collected.
CATALOG_SYNC_ENABLED=True
CATALOG_SYNC_BATCH_SIZE=25
CATALOG_SYNC_MAX_ATTEMPTS=5
CATALOG_SYNC_STALE_SECONDS=600
CATALOG_SYNC_RETENTION_SECONDS=604800
CATALOG_SYNC_ARCHIVE_SECONDS=2592000
